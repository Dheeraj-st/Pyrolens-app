# Multi-stage build for production frontend served by nginx
# Stage 1: Build the React/Vite application
FROM node:26-alpine AS builder

WORKDIR /web

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Build arguments for API URL (use relative path so nginx proxies to backend container)
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# Build the application
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine AS runner

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder stage
COPY --from=builder /web/dist /usr/share/nginx/html

# Add health check endpoint
RUN echo 'server { listen 80; location /health { return 200 "healthy\n"; add_header Content-Type text/plain; } }' > /etc/nginx/conf.d/health.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]